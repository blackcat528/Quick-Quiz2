<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 200 200" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#38bdf8"/>
      <stop offset="0.5" stop-color="#137c86"/>
      <stop offset="1" stop-color="#0b3c5d"/>
    </linearGradient>
    <linearGradient id="gold" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fde68a"/>
      <stop offset="1" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>

  <!-- rounded background -->
  <rect x="8" y="8" width="184" height="184" rx="46" fill="url(#bg)"/>

  <!-- soft glow circle -->
  <circle cx="150" cy="50" r="46" fill="#ffffff" fill-opacity="0.12"/>

  <!-- quiz card -->
  <rect x="44" y="52" width="112" height="96" rx="18" fill="#ffffff"/>
  <rect x="58" y="72" width="60" height="9" rx="4.5" fill="#cfe9f2"/>
  <rect x="58" y="90" width="84" height="9" rx="4.5" fill="#cfe9f2"/>
  <rect x="58" y="108" width="48" height="9" rx="4.5" fill="#cfe9f2"/>

  <!-- check mark badge -->
  <circle cx="142" cy="136" r="26" fill="url(#gold)" stroke="#ffffff" stroke-width="6"/>
  <path d="M128 136 L138 146 L157 125" fill="none" stroke="#0b3c5d" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- sparkles -->
  <path d="M40 36 L44 46 L54 50 L44 54 L40 64 L36 54 L26 50 L36 46 Z" fill="#fde68a"/>
  <circle cx="168" cy="30" r="4" fill="#ffffff" fill-opacity="0.8"/>
</svg>
